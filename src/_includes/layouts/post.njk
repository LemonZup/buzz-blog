---
layout: layouts/base.njk
bodyClass: is-post
---
<article class="post"><header class="post-hero"><a class="back-link" href="/">← Back to the catalogue</a><div class="entry-meta"><span>{{ category }}</span><time datetime="{{ page.date | isoDate }}">{{ page.date | displayDate }}</time><span>{{ content | readingMinutes }} min read</span></div><h1>{{ title }}</h1>{% if deck %}<p class="post-deck">{{ deck }}</p>{% endif %}<p class="byline">Written by {{ site.author }}</p></header><div class="reading-layout"><div class="prose">{% if sample %}<p class="sample-note">Sample entry — starter content for this blog.</p>{% endif %}{{ content | safe }}</div><aside class="reading-aside"><img class="reading-stripes" src="/assets/art/tangle-long.svg" alt="" aria-hidden="true"><p class="vertical-note">MARGIN SIGNALS - READING ROOM</p><a href="/about/">About the author ↗</a><a href="/archive/">Browse the archive ↗</a></aside></div><nav class="post-nav" aria-label="More posts">{% set previousPost = collections.posts | getPreviousCollectionItem %}{% set nextPost = collections.posts | getNextCollectionItem %}{% if previousPost %}<a href="{{ previousPost.url }}"><small>Older entry</small>{{ previousPost.data.title }} ↗</a>{% endif %}{% if nextPost %}<a href="{{ nextPost.url }}"><small>Newer entry</small>{{ nextPost.data.title }} ↗</a>{% endif %}<a href="/archive/"><small>Keep exploring</small>The complete archive ↗</a></nav></article>
