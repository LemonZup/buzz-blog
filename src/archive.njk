---
layout: layouts/base.njk
title: Archive
---
<header class="page-heading"><p class="eyebrow">The whole notebook</p><h1>All the loose threads.</h1><p>Browse every entry, collected by subject.</p></header><div class="archive">{% for topic in ['Writing', 'At the table', 'Notebook', 'Avigard', 'DFI'] %}<section id="{{ topic | slugify }}"><h2>{{ topic }}</h2>{% for post in collections.posts | reverse %}{% if post.data.category == topic %}<article><time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate }}</time><div><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p>{{ post.data.deck }}</p></div><span aria-hidden="true">↗</span></article>{% endif %}{% endfor %}</section>{% endfor %}</div>
